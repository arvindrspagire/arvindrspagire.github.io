्मल वारे (१८°N च्या उत्तरेस): उष्ण हवेचे वहन (उंचीनुसार वारे घड्याळाच्या दिशेने वळतात): गोरखपूर; थंड हवेचे वहन (वारे उलट दिशेने वळतात): नवी दिल्ली, आगरतळा."}],"tiles":[{"value":{"en":"747 kt","mr":"७४७ नॉट"},"label":{"en":"Westerly jet core","mr":"पश्चिमी झोत वारे"},"note":{"en":"Kochi · 155 hPa","mr":"कोची · १५५ hPa"}},{"value":{"en":"17.3°N","mr":"१७.३°N"},"label":{"en":"Subtropical ridge, 500 hPa","mr":"उच्च दाब पट्टा, ५०० hPa"},"note":{"en":"easterlies south, westerlies north","mr":"दक्षिणेस पूर्वी, उत्तरेस पश्चिमी वारे"}},{"value":{"en":"0","mr":"०"},"label":{"en":"Troughs / circulations","mr":"द्रोणीय / चक्रीय स्थिती"},"note":{"en":"none","mr":"नाही"}},{"value":{"en":"3 / 18","mr":"३ / १८"},"label":{"en":"Stations favouring thunderstorms","mr":"वादळास अनुकूल स्थानके"},"note":{"en":"Thiruvananthapuram, Minicoy, Amini","mr":"तिरुवनंतपुरम, मिनिकॉय, अमिनी"}},{"value":{"en":"60 mm","mr":"६० मिमी"},"label":{"en":"Most moisture (precipitable water)","mr":"सर्वाधिक बाष्प (PW)"},"note":{"en":"Thiruvananthapuram","mr":"तिरुवनंतपुरम"}},{"value":{"en":"-5 m/s","mr":"-५ मी/से"},"label":{"en":"Monsoon shear (u850 − u200)","mr":"मान्सून वारे फरक (u850 − u200)"},"note":{"en":"not monsoon-like","mr":"मान्सूनसारखा नाही"}}],"isotach":[[20,"#cde2fb"],[40,"#9ec5f4"],[60,"#6da7ec"],[80,"#3987e5"],[999,"#1c5cab"]]}